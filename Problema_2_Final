# Función para calcular el precio final

def calcular_precio_final(categoria, precio_base, categoria_objetivo, umbral):
    descuento = 0.15
    
    if categoria == categoria_objetivo and precio_base > umbral:
        precio_final = precio_base * (1 - descuento)
    else:
        precio_final = precio_base
    
    return precio_final

# Parámetros de categoria objetivo y umbral de la promoción

categoria_objetivo = "Plato Fuerte"
umbral_precio = 20000

# Salida del menú con precios finales aplicando la promoción
print("MENÚ CON PROMOCIÓN APLICADA\n")

for producto in menu:
    nombre = producto[0]
    categoria = producto[1]
    precio_base = producto[2]

    precio_final = calcular_precio_final(
        categoria,
        precio_base,
        categoria_objetivo,
        umbral_precio
    )

    print(f"Producto: {nombre}")
    print(f"Categoría: {categoria}")
    print(f"Precio Base: ${precio_base}")
    print(f"Precio Final: ${int(precio_final)}")
